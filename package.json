{
  "name": "whatsapp-document-automation",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @mvp/api --filter @mvp/dashboard dev",
    "dev:validum": "pnpm --filter @mvp/validum dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @mvp/api test",
    "db:generate": "pnpm --filter @mvp/api prisma:generate",
    "db:migrate": "pnpm --filter @mvp/api prisma:migrate",
    "db:deploy": "pnpm --filter @mvp/api prisma:deploy"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
