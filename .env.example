# General
NODE_ENV=development
API_PORT=3001
DASHBOARD_PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=28800
DASHBOARD_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# PostgreSQL (provided by docker-compose in local development)
DATABASE_URL=postgresql://document_user:document_password@localhost:5432/document_automation?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally; AWS S3, Cloudflare R2, etc. in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Email transaccional para invitaciones y recuperación de acceso
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Validum <no-reply@example.com>

# WhatsApp Business Cloud API (Meta). Leave blank to use the logging adapter locally.
WHATSAPP_VERIFY_TOKEN=choose-a-private-webhook-verification-token
WHATSAPP_APP_SECRET=provided-by-meta-app-dashboard
WHATSAPP_ACCESS_TOKEN=provided-by-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=provided-by-meta
WHATSAPP_API_VERSION=v22.0

# Document intelligence provider. Choose: mock | openai | google-vision | azure-document-intelligence
DOCUMENT_AI_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Bootstrap administrator (created only when explicitly seeded)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding-123

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001/api
