DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/validum
REDIS_URL=redis://localhost:6379
JWT_SECRET=reemplazar-con-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=28800
JWT_REMEMBER_EXPIRES_IN_SECONDS=2592000
DASHBOARD_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
RESEND_API_KEY=reemplazar
EMAIL_FROM=Validum <no-reply@su-dominio.com>

# Ingesta externa opcional (por ejemplo desde n8n). Mínimo 32 caracteres; si
# falta o es más corta, la API rechaza toda ingesta. Nunca exponga esta
# variable como VITE_*. No hace falta si solo se usa la lectura interna de Gmail.
CORRESPONDENCIA_INGEST_API_KEY=reemplazar-con-un-secreto-aleatorio-de-al-menos-32-caracteres

# --- Lectura automática de buzones de Gmail ---
# Clave con la que se cifran los tokens de Google guardados en la base de datos
# y se firma el parámetro `state` del flujo OAuth. Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
# ATENCIÓN: si cambia esta clave, los tokens guardados dejan de poder
# descifrarse y hay que volver a conectar cada cuenta.
CORRESPONDENCIA_TOKEN_KEY=reemplazar-con-un-secreto-aleatorio-de-al-menos-32-caracteres

# Credenciales del cliente OAuth creado en Google Cloud (tipo aplicación web).
# La URL de redirección debe registrarse allí exactamente igual que aquí.
GOOGLE_OAUTH_CLIENT_ID=reemplazar.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=reemplazar
GOOGLE_OAUTH_REDIRECT_URI=https://su-api/api/correspondencia/cuentas/oauth/callback

# A dónde vuelve el navegador después de autorizar una cuenta. Si se deja
# vacío, el callback responde en JSON en lugar de redirigir.
CORRESPONDENCIA_OAUTH_REDIRECT_APP=https://su-panel/correspondencia

# Clasificación con Gemini. La facturación de la API de Google es independiente
# de cualquier suscripción de Gemini; el nivel gratuito no debe usarse con
# correos reales porque Google puede usar su contenido para mejorar productos.
GEMINI_API_KEY=reemplazar
GEMINI_MODEL=gemini-flash-lite-latest

# Ritmo de revisión de los buzones y tope de correos por ciclo y cuenta.
# El tope evita que una bandeja acumulada dispare el costo del modelo.
CORRESPONDENCIA_POLL_CRON=*/5 * * * *
CORRESPONDENCIA_MAX_POR_CICLO=50
CORRESPONDENCIA_POLL_ENABLED=true

# Solo para crear el primer administrador. En producción, elimínalas de Railway
# después de comprobar el primer inicio de sesión.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@su-dominio.com
ADMIN_PASSWORD=reemplazar-con-una-clave-de-al-menos-12-caracteres

# Almacenamiento privado compatible con S3 (AWS, R2, Wasabi o MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=reemplazar
S3_SECRET_ACCESS_KEY=reemplazar
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Meta WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=reemplazar-con-token-privado
WHATSAPP_ACCESS_TOKEN=reemplazar-con-token-de-sistema
WHATSAPP_PHONE_NUMBER_ID=reemplazar
WHATSAPP_APP_SECRET=reemplazar-con-secreto-de-la-app
WHATSAPP_API_VERSION=v22.0

# Solo desarrollo local. Nunca habilitar en Railway.
WHATSAPP_SKIP_SIGNATURE_VERIFICATION=false
