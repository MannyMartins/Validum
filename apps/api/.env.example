DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/validum
REDIS_URL=redis://localhost:6379
JWT_SECRET=reemplazar-con-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=28800
DASHBOARD_ORIGIN=http://localhost:3002

# Almacenamiento privado compatible con S3 (AWS, R2, Wasabi o MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=reemplazar
S3_SECRET_ACCESS_KEY=reemplazar
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Meta WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=reemplazar-con-token-privado
WHATSAPP_ACCESS_TOKEN=reemplazar-con-token-de-sistema
WHATSAPP_PHONE_NUMBER_ID=reemplazar
WHATSAPP_APP_SECRET=reemplazar-con-secreto-de-la-app
WHATSAPP_API_VERSION=v22.0

# Solo desarrollo local. Nunca habilitar en Railway.
WHATSAPP_SKIP_SIGNATURE_VERIFICATION=false
