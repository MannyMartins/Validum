generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
}

enum CaseStatus {
  RECEIVED
  PROCESSING
  REVIEW_REQUIRED
  READY
  DELIVERED
  FAILED
}

enum DocumentStatus {
  RECEIVED
  STORED
  PROCESSING
  PROCESSED
  REVIEW_REQUIRED
  FAILED
}

enum AffiliateDocumentCategory {
  CONTRIBUTOR_IDENTITY
  SPOUSE_IDENTITY
  BENEFICIARY_IDENTITY
  CIVIL_REGISTRY
  OTHER
}

enum Channel {
  WHATSAPP
  DASHBOARD
  API
}

enum TemplateEntityType {
  EPS
  ARL
  AFP
  CCF
  IPS
  OTHER
}

enum ApplicationType {
  AFFILIATION
  CHANGE
  DISABILITY
  TRANSFER
  OTHER
}

enum ApplicationStatus {
  DRAFT
  DATA_PENDING
  READY_FOR_REVIEW
  APPROVED
  GENERATED
  SUBMITTED
  REJECTED
}

enum ConversationState {
  NEW
  AWAITING_APPLICATION_TYPE
  AWAITING_DOCUMENT
  AWAITING_FULL_NAME
  AWAITING_EPS
  COMPLETED
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  role UserRole @default(ANALYST)
  createdAt DateTime @default(now())
  auditLogs AuditLog[]
  organizationsCreated Organization[] @relation("OrganizationCreator")
  organizationMemberships OrganizationMember[]
  preference UserPreference?
  soporteDocumentos SoporteDocumento[]
}

model Company {
  id                    String   @id @default(uuid())
  legalName             String
  documentType          String   @default("NIT")
  documentNumber        String
  verificationDigit     String?
  department            String?
  city                  String?
  address               String?
  phone                 String?
  email                 String?
  humanResourcesContact String?
  tradeName             String?
  legalRepresentative   String?
  representativeDocument String?
  economicActivity      String?
  payerType             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  employees             Employee[]
  applications          Application[]
  userPreferences       UserPreference[]
  @@unique([documentType, documentNumber])
}

model Employee {
  id                    String   @id @default(uuid())
  companyId             String?
  company               Company? @relation(fields: [companyId], references: [id])
  documentType          String
  documentNumber        String   @unique
  firstName             String
  middleName            String?
  firstSurname          String
  secondSurname         String?
  birthDate             DateTime?
  sex                   String?
  genderIdentity        String?
  maritalStatus         String?
  nationality           String?
  birthCountry          String   @default("CO")
  birthDepartment       String?
  birthCity             String?
  issueCountry          String   @default("CO")
  issueDepartment       String?
  issueCity             String?
  issueDate             DateTime?
  residenceDepartment   String?
  residenceCity         String?
  residenceType         String?
  address               String?
  neighborhood          String?
  municipalityCode      String?
  departmentCode        String?
  mobilePhone           String?
  landlinePhone         String?
  localityCommune       String?
  email                 String?
  epsName               String?
  epsCode               String?
  arlName               String?
  arlRiskLevel          Int?
  pensionFund           String?
  compensationFund      String?
  affiliationType       String?
  affiliationMode       String?
  healthRegime          String?
  affiliateType         String?
  epsRegistrationCode   String?
  noveltyType           String?
  mobilityRegime        String?
  transferRegime        String?
  noveltyDate           DateTime?
  previousEps           String?
  transferReason        String?
  previousCompensationFund String?
  contributorType       String?
  contributorTypeCode   String?
  contributorSubtype    String?
  satRequest             String?
  ethnicity             String?
  disability            String?
  sisbenScore            Decimal? @db.Decimal(8, 2)
  specialGroup           String?
  condition              String?
  salary                Decimal? @db.Decimal(14, 2)
  position              String?
  workDepartment        String?
  selectedIps           String?
  ipsCode               String?
  startDate             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  beneficiaries         Beneficiary[]
  documents             AffiliateDocument[]
  applications          Application[]
  soporteDocumentos     SoporteDocumento[]
}

model AffiliateDocument {
  id            String                    @id @default(uuid())
  employeeId    String
  employee      Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  beneficiaryId String?
  category      AffiliateDocumentCategory
  originalName  String
  contentType   String
  storageKey    String                    @unique
  createdAt     DateTime                  @default(now())
  @@index([employeeId, category])
}

model Beneficiary {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  relationship   String
  documentType   String
  documentNumber String
  firstName      String
  middleName     String?
  firstSurname   String
  secondSurname  String?
  birthDate      DateTime?
  sex            String?
  nationality    String?
  birthCountry   String?
  birthDepartment String?
  birthCity      String?
  ethnicity      String?
  disability     String?
  condition      String?
  residenceCity  String?
  residenceZone  String?
  residenceDepartment String?
  phone           String?
  upcValue        Decimal? @db.Decimal(14, 2)
  selectedIps     String?
  ipsCode         String?
  createdAt      DateTime @default(now())
  @@unique([employeeId, documentType, documentNumber])
}

model FormTemplate {
  id             String             @id @default(uuid())
  name           String
  entityName     String
  entityType     TemplateEntityType
  applicationType ApplicationType
  description    String?
  storageKey     String
  thumbnailKey   String?
  pageCount      Int
  pageSizes      Json?
  layoutFingerprint String?
  version        Int                @default(1)
  active         Boolean            @default(true)
  mappingStatus  String             @default("draft")
  fields         TemplateField[]
  applications   Application[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  @@unique([entityName, applicationType, version])
}

model TemplateField {
  id                   String       @id @default(uuid())
  templateId           String
  template             FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  page                 Int
  x                    Float
  y                    Float
  width                Float
  height               Float
  dataSource           String
  fieldKey             String
  label                String
  fieldType            String       @default("text")
  fontSize             Float        @default(10)
  fontFamily           String       @default("helvetica")
  alignment            String       @default("left")
  verticalAlignment    String       @default("middle")
  bold                 Boolean      @default(false)
  uppercase            Boolean      @default(false)
  color                String       @default("#000000")
  checkboxCharacter    String?
  checkboxMatchValue   String?
  checkboxRule         Json?
  dateFormat           String?
  numberFormat         String?
  stampText            String?
  stampSubtext         String?
  stampShape           String?
  stampBorderColor     String?
  stampFillColor       String?
  stampBorderWidth     Float?
  stampOpacity         Float?
  characterByCharacter Boolean      @default(false)
  characterSpacing     Float?
  characterCount       Int?
  padding              Float        @default(1)
  overflowPolicy       String       @default("error")
  minFontSize          Float        @default(6)
  maxLength            Int?
  acroFieldName        String?
  required             Boolean      @default(false)
  defaultValue         String?
  @@index([templateId, page])
}

model Application {
  id                String            @id @default(uuid())
  reference         String            @unique
  type              ApplicationType
  status            ApplicationStatus @default(DRAFT)
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id])
  companyId         String?
  company           Company?          @relation(fields: [companyId], references: [id])
  templateId        String?
  template          FormTemplate?     @relation(fields: [templateId], references: [id])
  caseId            String?           @unique
  case              Case?             @relation(fields: [caseId], references: [id])
  formData          Json?
  missingFields     Json?
  generatedFileKey  String?
  approvedById      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Contact {
  id String @id @default(uuid())
  whatsappId String @unique
  displayName String?
  cases Case[]
  conversation ConversationSession?
  whatsappMessages WhatsAppMessage[]
  createdAt DateTime @default(now())
}

model ConversationSession {
  id        String            @id @default(uuid())
  contactId String            @unique
  contact   Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  state     ConversationState @default(NEW)
  caseId    String?
  context   Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model WhatsAppMessage {
  id            String   @id @default(uuid())
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  metaMessageId String   @unique
  direction     String
  messageType   String
  content       String?
  createdAt     DateTime @default(now())
  @@index([contactId, createdAt])
}

model Case {
  id String @id @default(uuid())
  reference String @unique
  status CaseStatus @default(RECEIVED)
  epsName String?
  contactId String
  contact Contact @relation(fields: [contactId], references: [id])
  documents Document[]
  extractedData Json?
  application Application?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id String @id @default(uuid())
  caseId String
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  originalName String
  contentType String
  storageKey String @unique
  sourceMessageId String? @unique
  status DocumentStatus @default(RECEIVED)
  extractedText String?
  extraction Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(uuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id])
  action String
  entityType String
  entityId String
  channel Channel @default(API)
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdBy String?
  creator   User?    @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           OrganizationMember[]
  userPreferences   UserPreference[]
  soporteDocumentos SoporteDocumento[]
  stampPresets      StampPreset[]
  generatedForms    GeneratedForm[]
  novelties         Novelty[]
  pilaForms         PilaForm[]

  @@map("organizations")
  @@index([createdBy])
}

model OrganizationMember {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("analyst")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@id([organizationId, userId])
  @@index([userId, active])
  @@map("organization_members")
}

model UserPreference {
  userId          String        @id
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  activeCompanyId String?
  activeCompany   Company?      @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull)
  updatedAt       DateTime      @updatedAt

  @@map("user_preferences")
  @@index([organizationId])
  @@index([activeCompanyId])
}

model SoporteDocumento {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  nombre         String
  categoria      String        @default("Otro")
  tipoArchivo    String        @map("tipo_archivo")
  tamanoBytes    BigInt        @default(0) @map("tamano_bytes")
  storagePath    String        @map("storage_path")
  metadata       Json?         @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@index([ownerId])
  @@index([employeeId])
  @@map("soporte_documentos")
}

model StampPreset {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stampId        String        @map("stamp_id")
  name           String
  definition     Json
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, stampId])
  @@unique([organizationId, stampId])
  @@map("stamp_presets")
}

model GeneratedForm {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedFormId   String        @map("generated_form_id")
  templateId        String?       @map("template_id")
  employeeId        String?       @map("employee_id")
  templateName      String        @map("template_name")
  employeeName      String        @map("employee_name")
  pdfStoragePath    String        @map("pdf_storage_path")
  manualFields      Json?         @default("{}") @map("manual_fields")
  procedureFields   Json?         @default("{}") @map("procedure_fields")
  sourcePdfFileName String?       @map("source_pdf_file_name")
  generatedAt       DateTime      @default(now()) @map("generated_at")

  @@index([organizationId, generatedAt])
  @@unique([organizationId, generatedFormId])
  @@map("generated_forms")
}

model Novelty {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  noveltyId      String        @map("novelty_id")
  employeeId     String        @map("employee_id")
  noveltyType    String        @map("novelty_type")
  startDate      DateTime      @map("start_date")
  endDate        DateTime?     @map("end_date")
  status         String
  data           Json?         @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, employeeId])
  @@unique([organizationId, noveltyId])
  @@map("novelties")
}

model PilaForm {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formId         String        @map("form_id")
  period         String
  formNumber     String        @map("form_number")
  paymentStatus  String        @map("payment_status")
  data           Json?         @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, formId])
  @@unique([organizationId, formId])
  @@map("pila_forms")
}
